# Proofs of LAWS.bend. Each law is a finite case split over model.bend's tables:
# every case either computes to the claim ({==}) or rests on an assumption that
# cannot hold. The large split in nothing_needs_device_check is generated by
# gen_proof.py; the checker verifies every case independently of the generator.
import Base
import ./model.bend as M
import ./LAWS.bend as Laws

def exfalso(-Goal: Type, e: Empty) -> Goal:
  match e:

def true_ty(b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

def false_ty(b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

# True and False differ.
def true_is_not_false(e: {True{} == False{} : Bool}) -> Empty:
  %e : true_ty(_)
  Unit{}

def false_is_not_true(e: {False{} == True{} : Bool}) -> Empty:
  %e : false_ty(_)
  Unit{}

def flagged_ty(v: M.Verdict) -> Type:
  match v:
    case M.NeedsDeviceCheck{}:
      Empty
    case M.Unaffected{}:
      Unit
    case M.VerifiedSame{}:
      Unit

# Unaffected and VerifiedSame are not NeedsDeviceCheck.
def unaffected_clash(e: {M.Unaffected{} == M.NeedsDeviceCheck{} : M.Verdict}) -> Empty:
  %e : flagged_ty(_)
  Unit{}

def verified_clash(e: {M.VerifiedSame{} == M.NeedsDeviceCheck{} : M.Verdict}) -> Empty:
  %e : flagged_ty(_)
  Unit{}

def Laws.x_features_unaffected(f, p):
  match f:
    case M.HomeTimeline{}:
      e => {==}
    case M.Mentions{}:
      e => {==}
    case M.Bookmarks{}:
      e => {==}
    case M.Search{}:
      e => {==}
    case M.UserProfile{}:
      e => {==}
    case M.Thread{}:
      e => {==}
    case M.CliJsonl{}:
      e => {==}
    case M.Auth{}:
      e => {==}
    case M.HfModelPicker{}:
      e => {==}
    case M.OpenRouterModels{}:
      e => {==}
    case M.SemanticRank{}:
      e => exfalso({M.verdict(M.SemanticRank{}, p) == M.Unaffected{} : M.Verdict}, true_is_not_false(e))
    case M.ClusterTimeline{}:
      e => exfalso({M.verdict(M.ClusterTimeline{}, p) == M.Unaffected{} : M.Verdict}, true_is_not_false(e))
    case M.ClusterTopics{}:
      e => exfalso({M.verdict(M.ClusterTopics{}, p) == M.Unaffected{} : M.Verdict}, true_is_not_false(e))
    case M.MlxProbe{}:
      e => exfalso({M.verdict(M.MlxProbe{}, p) == M.Unaffected{} : M.Verdict}, true_is_not_false(e))

def Laws.nothing_needs_device_check(f, p):
  match f p:
    case M.HomeTimeline{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.HomeTimeline{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.HomeTimeline{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.HomeTimeline{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.Mentions{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.Mentions{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.Mentions{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.Mentions{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.Bookmarks{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.Bookmarks{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.Bookmarks{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.Bookmarks{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.Search{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.Search{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.Search{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.Search{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.UserProfile{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.UserProfile{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.UserProfile{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.UserProfile{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.Thread{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.Thread{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.Thread{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.Thread{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.CliJsonl{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.CliJsonl{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.CliJsonl{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.CliJsonl{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.Auth{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.Auth{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.Auth{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.Auth{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.HfModelPicker{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.HfModelPicker{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.HfModelPicker{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.HfModelPicker{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.OpenRouterModels{} M.Starlette{}:
      e => unaffected_clash(e)
    case M.OpenRouterModels{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.OpenRouterModels{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.OpenRouterModels{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.SemanticRank{} M.Starlette{}:
      e => verified_clash(e)
    case M.SemanticRank{} M.Transformers{}:
      e => verified_clash(e)
    case M.SemanticRank{} M.Tokenizers{}:
      e => verified_clash(e)
    case M.SemanticRank{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.ClusterTimeline{} M.Starlette{}:
      e => verified_clash(e)
    case M.ClusterTimeline{} M.Transformers{}:
      e => verified_clash(e)
    case M.ClusterTimeline{} M.Tokenizers{}:
      e => verified_clash(e)
    case M.ClusterTimeline{} M.Safetensors{}:
      e => unaffected_clash(e)
    case M.ClusterTopics{} M.Starlette{}:
      e => verified_clash(e)
    case M.ClusterTopics{} M.Transformers{}:
      e => verified_clash(e)
    case M.ClusterTopics{} M.Tokenizers{}:
      e => verified_clash(e)
    case M.ClusterTopics{} M.Safetensors{}:
      e => verified_clash(e)
    case M.MlxProbe{} M.Starlette{}:
      e => verified_clash(e)
    case M.MlxProbe{} M.Transformers{}:
      e => unaffected_clash(e)
    case M.MlxProbe{} M.Tokenizers{}:
      e => unaffected_clash(e)
    case M.MlxProbe{} M.Safetensors{}:
      e => unaffected_clash(e)

def Laws.starlette_verified_for_mlx_features(f):
  match f:
    case M.HomeTimeline{}:
      e => exfalso({M.verdict(M.HomeTimeline{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.Mentions{}:
      e => exfalso({M.verdict(M.Mentions{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.Bookmarks{}:
      e => exfalso({M.verdict(M.Bookmarks{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.Search{}:
      e => exfalso({M.verdict(M.Search{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.UserProfile{}:
      e => exfalso({M.verdict(M.UserProfile{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.Thread{}:
      e => exfalso({M.verdict(M.Thread{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.CliJsonl{}:
      e => exfalso({M.verdict(M.CliJsonl{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.Auth{}:
      e => exfalso({M.verdict(M.Auth{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.HfModelPicker{}:
      e => exfalso({M.verdict(M.HfModelPicker{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.OpenRouterModels{}:
      e => exfalso({M.verdict(M.OpenRouterModels{}, M.Starlette{}) == M.VerifiedSame{} : M.Verdict}, false_is_not_true(e))
    case M.SemanticRank{}:
      e => {==}
    case M.ClusterTimeline{}:
      e => {==}
    case M.ClusterTopics{}:
      e => {==}
    case M.MlxProbe{}:
      e => {==}

def Laws.probe_only_sees_starlette(p):
  match p:
    case M.Starlette{}:
      differs => exfalso({M.verdict(M.MlxProbe{}, M.Starlette{}) == M.Unaffected{} : M.Verdict}, differs({==}))
    case M.Transformers{}:
      differs => {==}
    case M.Tokenizers{}:
      differs => {==}
    case M.Safetensors{}:
      differs => {==}

def Laws.safetensors_only_through_chat(f):
  match f:
    case M.HomeTimeline{}:
      e => exfalso({M.uses(M.HomeTimeline{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.Mentions{}:
      e => exfalso({M.uses(M.Mentions{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.Bookmarks{}:
      e => exfalso({M.uses(M.Bookmarks{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.Search{}:
      e => exfalso({M.uses(M.Search{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.UserProfile{}:
      e => exfalso({M.uses(M.UserProfile{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.Thread{}:
      e => exfalso({M.uses(M.Thread{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.CliJsonl{}:
      e => exfalso({M.uses(M.CliJsonl{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.Auth{}:
      e => exfalso({M.uses(M.Auth{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.HfModelPicker{}:
      e => exfalso({M.uses(M.HfModelPicker{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.OpenRouterModels{}:
      e => exfalso({M.uses(M.OpenRouterModels{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.SemanticRank{}:
      e => exfalso({M.uses(M.SemanticRank{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.ClusterTimeline{}:
      e => exfalso({M.uses(M.ClusterTimeline{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))
    case M.ClusterTopics{}:
      e => {==}
    case M.MlxProbe{}:
      e => exfalso({M.uses(M.MlxProbe{}, M.Chat{}) == True{} : Bool}, false_is_not_true(e))

